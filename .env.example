# ---- Anthropic (AI Concept Studio) ----
# Only needed if you use the built-in Next.js /api routes (fallback mode).
# When NEXT_PUBLIC_API_URL points at the NestJS backend, the key lives there instead.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- NestJS backend ----
# Set this to run against the NestJS API (recommended). Leave empty to use
# the built-in Next.js route handlers instead.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Supabase ----
# Project URL + anon (publishable) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key — SERVER ONLY, never expose. Used by the admin dashboard.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Simple gate for /admin (choose any long random string)
ADMIN_TOKEN=change-me-to-something-long

# ---- Analytics (optional, privacy-friendly) ----
# Set to your live domain to enable Plausible analytics (visitors, pages, sources).
# Leave empty and no analytics script loads. Sign up at plausible.io and add the site.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
